    {
      "id": "ynaga0b_kk2QiK8faCgSC",
      "type": "text",
      "x": 825.2018586944754,
      "y": 15997.561657661074,
      "width": 585.2026977539062,
      "height": 770,
      "angle": 0,
      "strokeColor": "#1e1e1e",
