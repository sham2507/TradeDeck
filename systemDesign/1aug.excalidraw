      "link": null,
      "locked": false,
      "text": "core services pending\n\n\n\n\nlogics for trailing.py and portfolio.py\n\nbackend logic for profilio sl and trailing\n\nbackend logic for statergy sl and trailing\n\n\n\n\nORDER PLACING THROUGH API\n\nlogic for hedge.py\n\nhedge backend db intergration and logic backend service\n\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "5vB3n0G2_v5S5jdTeTLu4",
      "originalText": "core services pending\n\n\n\n\nlogics for trailing.py and portfolio.py\n\nbackend logic for profilio sl and trailing\n\nbackend logic for statergy sl and trailing\n\n\n\n\nORDER PLACING THROUGH API\n\nlogic for hedge.py\n\nhedge backend db intergration and logic backend service\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
